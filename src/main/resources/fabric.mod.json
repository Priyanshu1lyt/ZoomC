  "authors": ["NotHeartYT"],
  "license": "MIT",
  "icon": "assets/zoomc/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.nothearyt.zoomc.ZoomCClient"]
  },
  "mixins": ["zoomc.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
